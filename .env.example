# =============================================================================
# Semantic Search — environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Google Cloud / Vertex AI (required)
# -----------------------------------------------------------------------------

# Your GCP project ID (e.g. "my-project-123456")
GOOGLE_CLOUD_PROJECT=

# Region where Vertex AI is enabled (default: us-central1)
GOOGLE_CLOUD_REGION=us-central1

# Option 1 — Local dev: path to a service-account key JSON file
# Create a service account with roles/aiplatform.user, download the key,
# and point this variable at the file. NEVER commit the file (see .gitignore).
GOOGLE_APPLICATION_CREDENTIALS=

# Option 2 — Vercel / CI: paste the entire service-account JSON as a single line.
# The app writes it to a temp file and sets GOOGLE_APPLICATION_CREDENTIALS.
# Tip: `jq -c . service-account.json | pbcopy` to copy a compact single-line version.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# -----------------------------------------------------------------------------
# Upstash Redis (optional — rate limiting degrades to no-op without it)
# -----------------------------------------------------------------------------

# Your Upstash Redis REST URL (from console.upstash.com → REST API)
UPSTASH_REDIS_REST_URL=

# Your Upstash Redis REST token (read-write)
UPSTASH_REDIS_REST_TOKEN=
